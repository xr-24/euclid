{
  "version": 1,
  "$defs": {
    "video_playback": {"type":"string", "enum":["status","play","pause","restart","next","previous"]},
    "time_mode": {"type":"string", "enum":["manual","fixed","cycle"]},
    "time_of_day": {"type":"number", "minimum":0, "maximum":24, "description":"Local hour in a 24-hour day"},
    "day_length": {"type":"number", "minimum":1, "maximum":120, "description":"Real minutes per full day"},
    "weather_amount": {"type":"number", "minimum":0, "maximum":1},
    "terrain_points": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/position" } },
    "terrain_brush": { "type": "string", "enum": ["raise", "lower", "smooth", "flatten", "paint"] },
    "terrain_radius": { "type": "number", "minimum": 4, "maximum": 60 },
    "terrain_strength": { "type": "number", "minimum": 0.01, "maximum": 4 },
    "terrain_paint": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "material_query": { "type": "string", "maxLength": 240 },
    "building_opening": {"type": "object", "properties": {"kind": {"type": "string", "enum": ["none", "door", "window", "archway"]}, "motion": {"type": "string", "enum": ["hinge", "slide", "fixed"]}, "offset": {"type": "number", "minimum": -30, "maximum": 30}, "width": {"type": "number", "minimum": 0.5, "maximum": 8}, "height": {"type": "number", "minimum": 0.4, "maximum": 6}, "sill": {"type": "number", "minimum": 0, "maximum": 4}, "open": {"type": "boolean"}, "slide_side": {"type": "string", "enum": ["left", "right"]}}, "required": []},
    "wall_opening_list": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/building_opening"}},
    "plan_point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -32, "maximum": 32}},
    "partition": {
      "type": "object",
      "properties": {
        "start": {"$ref": "#/$defs/plan_point"},
        "end": {"$ref": "#/$defs/plan_point"},
        "height": {"type": "number", "minimum": 0.4, "maximum": 10},
        "thickness": {"type": "number", "minimum": 0.08, "maximum": 0.7},
        "openings": {"$ref": "#/$defs/wall_opening_list"},
        "material": {"$ref": "#/$defs/piece_material"}
      },
      "required": ["start", "end"]
    },
    "stair_plan": {"type": "object", "properties": {"width": {"type": "number", "minimum": 0.5, "maximum": 20}, "rise": {"type": "number", "minimum": 0.1, "maximum": 5}, "run": {"type": "number", "minimum": 0.3, "maximum": 25}, "count": {"type": "number", "minimum": 1, "maximum": 32}}, "required": []},
    "piece_material": {
      "type": "object",
      "required": [],
      "properties": {
        "finish": {
          "type": "string",
          "description": "Start from a named finish in data/pieces/finishes.json (paints, plasters, brick, tiles, carpets, wood floors, paving, pool mosaics); the other fields override it",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "style": {
          "type": "string",
          "enum": [
            "standard",
            "lattice",
            "fractured_panels"
          ]
        },
        "line_spacing": {
          "type": "number",
          "description": "Distance between lattice lines in metres",
          "minimum": 1,
          "maximum": 8
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "texture": {
          "type": "string",
          "description": "An installed or imported PBR texture ID",
          "catalog": "surface_texture",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "texture_size": {
          "type": "number",
          "description": "Metres one texture tile covers",
          "minimum": 0.05,
          "maximum": 100
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emission": {
          "$ref": "#/$defs/color"
        },
        "emission_energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "alpha": {
          "type": "number",
          "description": "Opacity, from 0 (clear) to 1 (solid)",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "piece_offset": { "type": "number", "minimum": 0, "maximum": 4096 },
    "behavior": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Exact registered behavior ID",
          "pattern": "^[a-z_][a-z0-9_]{0,39}$"
        },
        "target_entity": {
          "type": "string",
          "description": "Exact door ID for a door behavior, or an empty string",
          "pattern": "^(?:[a-f0-9]{32})?$"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]{0,39}$"
              },
              "value": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "Numeric settings from the catalog. Empty uses defaults.",
          "maxItems": 6,
          "uniqueBy": "key"
        }
      },
      "required": [
        "id",
        "settings"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Clip name of 1 to 48 characters"
        },
        "duration": {
          "type": "number",
          "description": "Loop length in seconds, from 1 to 30"
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear",
            "smooth"
          ]
        },
        "keyframes": {
          "type": "array",
          "description": "2 to 10 ordered keys from zero to duration. Match endpoints, with whole turns allowed for rotation.",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "number"
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Three local offsets in metres, each within -2 to 2. Zero for companion."
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Three local Euler angles in degrees, each within -720 to 720. Zero for companion."
              },
              "pose": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Two companion Lift and Drift weights within -1 to 1. Zero for props and for clips with joint tracks."
              }
            },
            "required": [
              "time",
              "offset",
              "rotation",
              "pose"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "joint_tracks": {
          "type": "array",
          "description": "Up to 30 player finger tracks, or 16 tracks for props and companions. Empty for unrigged props or companion Lift/Drift clips.",
          "items": {
            "type": "object",
            "properties": {
              "joint": {
                "type": "string",
                "description": "Exact joint name from inspection"
              },
              "keyframes": {
                "type": "array",
                "description": "2 to 10 ordered keys. The first is at zero and the last at duration, with matching rotations.",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": {
                      "type": "number"
                    },
                    "rotation": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "description": "Three local Euler angles relative to rest in degrees, each within -180 to 180"
                    }
                  },
                  "required": [
                    "time",
                    "rotation"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10
              }
            },
            "required": [
              "joint",
              "keyframes"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        }
      },
      "required": [
        "name",
        "duration",
        "interpolation",
        "keyframes",
        "joint_tracks"
      ],
      "additionalProperties": false
    },
    "boolean": {
      "type": "boolean"
    },
    "entity": {
      "type": "string",
      "description": "Exact entity or prefab ID from the active scene catalog",
      "pattern": "^[a-f0-9]{32}$"
    },
    "zone": {
      "type": "string",
      "description": "Exact environment ID from list_environments",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "environment_name": {
      "type": "string",
      "description": "Name for a new environment",
      "maxLength": 48,
      "pattern": "^(?=[^\\x00-\\x1f\\x7f]*\\S)[^\\x00-\\x1f\\x7f]+$"
    },
    "prop_type": {
      "type": "string",
      "description": "A built-in prop type or an installed model ID",
      "pattern": "^[a-z_][a-z0-9_]{0,95}$"
    },
    "asset_query": {
      "type": "string",
      "description": "Short model search phrase",
      "maxLength": 120,
      "pattern": "\\S"
    },
    "node_path": {
      "type": "string",
      "description": "A node's path from the world root, such as Zone_villa/Pieces/Piece_12. Empty means the world itself. inspect_scene lists children to walk down.",
      "pattern": "^[A-Za-z0-9_@ .:/-]{0,240}$"
    },
    "property_name": {
      "type": "string",
      "description": "A property of that node, as inspect_scene lists it. Use a colon for a property of a resource it holds, such as material_override:albedo_color.",
      "pattern": "^[a-z_][a-z0-9_]{0,63}(:[a-z_][a-z0-9_]{0,63}){0,3}$"
    },
    "property_value": {
      "description": "The new value: a number, true or false, text, or a list of numbers for a vector or a color ([r, g, b] or [r, g, b, a], 0 to 1). Text like #ff8800 also works for a color.",
      "anyOf": [
        {"type": "number"},
        {"type": "boolean"},
        {"type": "string", "pattern": "^.{0,240}$"},
        {"type": "array", "items": {"type": "number"}}
      ]
    },
    "view_source": {
      "type": "string",
      "description": "player: the player's current view. point: from position, aimed at target. camera: a camera placed with place_camera.",
      "enum": ["player", "point", "camera"]
    },
    "camera_name": {
      "type": "string",
      "description": "A short name for a placed camera",
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "view_target": {
      "description": "Where to aim: a point [x, y, z] in metres, or a node path from inspect_scene.",
      "anyOf": [
        {"type": "array", "items": {"type": "number"}},
        {"type": "string", "pattern": "^[A-Za-z0-9_@ .:/-]{1,240}$"}
      ]
    },
    "field_of_view": {
      "type": "number",
      "description": "Field of view in degrees, 20 to 110. Default 70."
    },
    "agent_name": {
      "type": "string",
      "description": "An agent's name, as chat and draft_status show it, such as local-claude",
      "pattern": "^[a-z0-9_.-]{1,64}$"
    },
    "asset_id": {
      "type": "string",
      "description": "Exact downloadable model ID",
      "maxLength": 160,
      "pattern": "^(rig-)?(sf-[a-f0-9]{32}|ph-[A-Za-z0-9_-]{1,80})$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "all",
        "sketchfab",
        "polyhaven"
      ]
    },
    "animation_target": {
      "type": "string",
      "description": "Exact animation target ID, companion, or activity:<kind> (read, edit, run, search, think, tool, say) for the motion agents play during that activity",
      "pattern": "^(companion|activity:[a-z]{1,16}|[a-f0-9]{32})$"
    },
    "workshop_action": {
      "type": "string",
      "description": "Exact action from list_workshop_tools",
      "pattern": "^(grid_undo_edit|grid_action_[a-z][a-z0-9_]{0,31})$"
    },
    "position": {
      "type": "array",
      "description": "Three coordinates in metres",
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "minItems": 3,
      "maxItems": 3,
      "multipleOfHint": 0.05
    },
    "yaw": {
      "type": "number",
      "minimum": -360,
      "maximum": 360,
      "title": "Yaw",
      "multipleOfHint": 1
    },
    "scale": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4,
      "title": "Scale",
      "multipleOfHint": 0.05
    },
    "stretch": {
      "type": "array",
      "description": "Stretch along the prop's own width, height and depth (X, Y and Z after its yaw), multiplying its scale",
      "items": {
        "type": "number",
        "minimum": 0.2,
        "maximum": 5
      },
      "minItems": 3,
      "maxItems": 3,
      "multipleOfHint": 0.05
    },
    "color": {
      "type": "string",
      "description": "Six RGB hex digits",
      "pattern": "^[a-fA-F0-9]{6}$"
    },
    "player_pose": {
      "type": "string",
      "enum": [
        "rest",
        "point",
        "grab",
        "pinch",
        "open_palm"
      ]
    },
    "player_bob": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Walking bob multiplier. Default is 1."
    },
    "reset_clip": {
      "type": "boolean",
      "description": "Restore the built-in motion for the selected player pose."
    },
    "prop_name": {
      "type": "string",
      "description": "Display name. Empty restores the default.",
      "maxLength": 64,
      "pattern": "^(?:$|(?=[^\\x00-\\x1f\\x7f]*\\S)[^\\x00-\\x1f\\x7f]+)$"
    },
    "prefab_name": {
      "type": "string",
      "description": "New prefab name",
      "maxLength": 48,
      "pattern": "^(?=[^\\x00-\\x1f\\x7f]*\\S)[^\\x00-\\x1f\\x7f]+$"
    },
    "collision": {
      "type": "boolean",
      "title": "Collision",
      "description": "Whether a prop blocks movement. Off props remain selectable and hold their placement until collision is restored."
    },
    "prop_changes": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "yaw": {
          "$ref": "#/$defs/yaw"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "stretch": {
          "$ref": "#/$defs/stretch"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "collision": {
          "$ref": "#/$defs/collision"
        },
        "name": {
          "$ref": "#/$defs/prop_name"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "edit_changes": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "yaw": {
          "$ref": "#/$defs/yaw"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "stretch": {
          "$ref": "#/$defs/stretch"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "collision": {
          "$ref": "#/$defs/collision"
        },
        "name": {
          "$ref": "#/$defs/prop_name"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "position_change": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "behavior_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/behavior"
        },
        {
          "type": "null"
        }
      ]
    },
    "sun_azimuth": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "Compass direction the sunlight comes from, in degrees"
    },
    "sun_elevation": {
      "type": "number",
      "minimum": -30,
      "maximum": 90,
      "description": "Sun height above the horizon in degrees; below 0 is night"
    },
    "sun_energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 8,
      "description": "Sunlight strength"
    },
    "sky_choice": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(gradient|[A-Za-z0-9_.-]{1,92}\\.(hdr|exr))$",
      "description": "An installed HDRI sky file name, or gradient"
    },
    "sky_energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 4,
      "description": "Sky brightness and the light it casts"
    },
    "star_brightness": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Stars, which show once the sun is down"
    },
    "exposure": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 3,
      "description": "Camera exposure"
    },
    "eye_adaptation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How far the camera's exposure adapts between bright outdoors and dim rooms; 0 keeps one fixed exposure"
    },
    "bounce_light": {
      "type": "number",
      "minimum": 0,
      "maximum": 3,
      "description": "Strength of light bounced off surfaces (global illumination), which fills rooms and shadows"
    },
    "contrast": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.4,
      "description": "Image contrast; 1 is neutral"
    },
    "ambient_energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 3,
      "description": "Fill light from the sky"
    },
    "fog_density": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.08,
      "description": "Volumetric fog density; 0.002 is a light haze, 0.03 is thick"
    },
    "fog_direction": {
      "type": "number",
      "minimum": -0.9,
      "maximum": 0.9,
      "description": "How much fog glows toward the sun (positive) or away (negative)"
    },
    "haze_density": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.02,
      "description": "Distance haze that fades the horizon"
    },
    "shadow_distance": {
      "type": "number",
      "minimum": 10,
      "maximum": 250,
      "description": "How far from the camera sun shadows reach, in metres"
    },
    "reset_atmosphere": {
      "type": "boolean",
      "description": "Clear this environment's atmosphere edits before applying any others"
    }
  },
  "authored_properties": [
    "position",
    "yaw",
    "scale",
    "stretch",
    "name",
    "collision",
    "color"
  ],
  "entity_types": {
    "traffic_cone": {
      "label": "Traffic cone",
      "color": "ff681d",
      "factory": "cone",
      "built_in": true,
      "behavior_outputs": [
        "emission"
      ],
      "palette_label": "Spawn orange cone"
    },
    "pressure_plate": {
      "label": "Pressure plate",
      "color": "2d8394",
      "factory": "box",
      "size": [
        1.2,
        0.09,
        1.2
      ],
      "built_in": true,
      "behavior_outputs": [
        "emission",
        "door_open"
      ],
      "palette_label": "Spawn plate"
    },
    "sliding_door": {
      "label": "Sliding door",
      "color": "475567",
      "factory": "door",
      "size": [
        1.55,
        2.35,
        0.18
      ],
      "built_in": true,
      "palette_label": "Spawn door"
    },
    "imported_model": {
      "label": "Imported model",
      "color": "ffffff",
      "factory": "model",
      "asset_source": "runtime"
    },
    "library_model": {
      "label": "Library model",
      "color": "ffffff",
      "factory": "model",
      "asset_source": "library"
    }
  },
  "runtime_commands": {
    "workshop": {
      "source": "workshop_tools",
      "base": "run_workshop_tool",
      "name_rule": "workshop_action"
    },
    "behavior": {
      "source": "behaviors",
      "base": "set_behavior",
      "prefix": "attach_behavior_"
    }
  },
  "action_properties": [
    "position",
    "yaw",
    "scale",
    "color"
  ],
  "prefab_properties": [
    "type",
    "yaw",
    "scale",
    "stretch",
    "collision",
    "color",
    "asset_id",
    "animation",
    "behavior"
  ],
  "limits": {
    "environments": 128,
    "workshop_actions": 25,
    "runtime_behaviors": 24
  }
}
