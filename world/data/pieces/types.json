{
  "version": 1,
  "about": "Registered piece types. Environment documents, agents and the build menu use these; see docs/environment-authoring.md. Field rules use the same format as data/commands/schema.json and may $ref its $defs.",
  "common": {
    "id": { "type": "string", "description": "Unique within the environment", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$" },
    "type": { "type": "string", "maxLength": 32 },
    "name": { "type": "string", "maxLength": 64 },
    "position": { "type": "array", "description": "Three coordinates in metres", "items": {"type":"number", "minimum":-8000, "maximum":8000}, "minItems":3, "maxItems":3 },
    "rotation": { "type": "array", "description": "Degrees about X, Y and Z", "items": { "type": "number", "minimum": -360, "maximum": 360 }, "minItems": 3, "maxItems": 3 },
    "scale": { "type": "array", "description": "Scale along X, Y and Z", "items": { "type": "number", "minimum": 0.01, "maximum": 100 }, "minItems": 3, "maxItems": 3 },
    "hidden": { "type": "boolean" }
  },
  "types": {
    "group": {
      "label": "Group",
      "description": "Holds child pieces so they move, turn and hide together.",
      "script": "res://scripts/pieces/group_piece.gd",
      "required": [],
      "fields": {}
    },
    "shape": {
      "label": "Shape",
      "description": "A solid box, sphere, cylinder, capsule or flat plane with a material. Round shapes use size X as the diameter and size Y as the height.",
      "script": "res://scripts/pieces/shape_piece.gd",
      "required": ["shape", "size"],
      "defaults": { "shape": "box", "size": [1, 1, 1] },
      "fields": {
        "shape": { "type": "string", "enum": ["box", "sphere", "cylinder", "capsule", "plane"] },
        "size": { "type": "array", "description": "Metres along X, Y and Z", "items": { "type": "number", "minimum": 0.01, "maximum": 2000 }, "minItems": 3, "maxItems": 3 },
        "material": {"$ref": "#/$defs/piece_material"},
        "render": {"type": "boolean", "description": "Draw the shape. A collision-only shape can stay solid while invisible."},
        "collision_size": {"type": "array", "description": "Optional size of a box collider, independent of the visible shape.", "items": {"type": "number", "minimum": 0.01, "maximum": 2000}, "minItems": 3, "maxItems": 3},
        "collision": { "type": "boolean" },
        "cast_shadow": { "type": "boolean" }
      }
    },
    "light": {
      "label": "Light",
      "description": "A point (omni) or spot light. Spots shine along the piece's -Z.",
      "script": "res://scripts/pieces/light_piece.gd",
      "required": ["kind"],
      "defaults": { "kind": "omni" },
      "fields": {
        "kind": { "type": "string", "enum": ["omni", "spot"] },
        "color": { "$ref": "#/$defs/color" },
        "energy": { "type": "number", "minimum": 0, "maximum": 100 },
        "range": { "type": "number", "minimum": 0.1, "maximum": 500 },
        "angle": { "type": "number", "minimum": 1, "maximum": 89 },
        "attenuation": {"type":"number","minimum":0.01,"maximum":10},
        "shadows": { "type": "boolean" }
      }
    },
    "model": {
      "label": "Model",
      "description": "A model from the installed library or an imported asset.",
      "script": "res://scripts/pieces/model_piece.gd",
      "required": ["source", "asset_id"],
      "defaults": { "source": "library" },
      "fields": {
        "source": { "type": "string", "enum": ["library", "runtime", "generated", "polyhaven"] },
        "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$" },
        "collision": { "type": "boolean" },
        "model_height": {"type": "number", "minimum": 0.01, "maximum": 200},
        "model_lift": {"type": "number", "minimum": 0, "maximum": 100},
        "named_collision": {"type": "boolean"},
        "box_collision": {"type": "boolean"},
        "trunk": {"type": "array", "items": {"type": "number", "minimum": 0.01, "maximum": 30}, "minItems": 2, "maxItems": 2},
        "model_finish": {"type": "object", "properties": {"style": {"type": "string", "enum": ["pbr", "flat", "fresco", "foliage", "foliage_core", "coastal_terrain", "wet_sand"]}, "texture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "textures": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "minItems": 3, "maxItems": 4}, "tint": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 4}, "minItems": 3, "maxItems": 3}, "fallback": {"$ref": "#/$defs/color"}, "tile": {"type": "number", "minimum": 0.05, "maximum": 100}, "roughness": {"type": "number", "minimum": 0, "maximum": 1}, "metallic": {"type": "number", "minimum": 0, "maximum": 1}, "frieze": {"type": "boolean"}, "period": {"type": "number", "minimum": 0.1, "maximum": 100}, "offset": {"type": "number", "minimum": -1000, "maximum": 1000}, "main_view_only": {"type": "boolean"}, "cast_shadow": {"type": "boolean"}, "hidden": {"type": "boolean"}, "sea_level": {"type": "number", "minimum": -1000, "maximum": 1000}, "beach_top": {"type": "number", "minimum": -1000, "maximum": 1000}}, "required": []},
        "mesh_rules": {"type": "array", "items": {"type": "object", "properties": {"mesh": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "style": {"type": "string", "enum": ["pbr", "flat", "fresco", "foliage", "foliage_core", "coastal_terrain", "wet_sand"]}, "texture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "textures": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "minItems": 3, "maxItems": 4}, "tint": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 4}, "minItems": 3, "maxItems": 3}, "fallback": {"$ref": "#/$defs/color"}, "tile": {"type": "number", "minimum": 0.05, "maximum": 100}, "roughness": {"type": "number", "minimum": 0, "maximum": 1}, "metallic": {"type": "number", "minimum": 0, "maximum": 1}, "frieze": {"type": "boolean"}, "period": {"type": "number", "minimum": 0.1, "maximum": 100}, "offset": {"type": "number", "minimum": -1000, "maximum": 1000}, "main_view_only": {"type": "boolean"}, "cast_shadow": {"type": "boolean"}, "hidden": {"type": "boolean"}, "sea_level": {"type": "number", "minimum": -1000, "maximum": 1000}, "beach_top": {"type": "number", "minimum": -1000, "maximum": 1000}}, "required": ["mesh"]}, "maxItems": 64},
        "legacy_prop": {"type": "boolean"},
        "placement_surface": {"type": "boolean"}
      }
    },
    "box_batch": {
      "label": "Box batch",
      "description": "Draw many decorative boxes as one batch. Each box has a position, rotation and size relative to the piece.",
      "script": "res://scripts/pieces/box_batch_piece.gd",
      "required": [
        "instances"
      ],
      "defaults": {
        "instances": [
          {
            "position": [
              0,
              0,
              0
            ],
            "rotation": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ]
          }
        ]
      },
      "fields": {
        "instances": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "required": ["position", "rotation", "size"], "properties": {"position": {"$ref": "#/$defs/position"}, "rotation": {"type": "array", "description": "Degrees about X, Y and Z", "items": {"type": "number", "minimum": -360, "maximum": 360}, "minItems": 3, "maxItems": 3}, "size": {"type": "array", "description": "Metres along X, Y and Z", "items": {"type": "number", "minimum": 0.01, "maximum": 2000}, "minItems": 3, "maxItems": 3}}}},
        "material": {"$ref": "#/$defs/piece_material"},
        "height_scale": {"type": "number", "description": "Scale the batch and its offsets along its local Y axis", "minimum": 0.1, "maximum": 8},
        "cast_shadow": {"type": "boolean"}
      }
    },
    "scatter": {
      "label": "Vegetation scatter",
      "description": "Place a seeded patch of plants or rocks, with optional height and slope filters. Put it under a terrain piece to follow its surface.",
      "script": "res://scripts/pieces/scatter_piece.gd",
      "required": ["asset_id", "scatter_size"],
      "defaults": {"asset_id": "grass_medium_02", "scatter_size": [18, 18], "count": 32, "spacing": 1, "range": 90, "shadows": false, "follow_terrain": true},
      "fields": {
        "asset_id": {"type": "string", "catalog": "vegetation", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
        "follow_terrain": {"type": "boolean", "description": "Use the parent terrain height when placed under terrain."},
        "scatter_size": {"type": "array", "items": {"type": "number", "minimum": 0.1, "maximum": 6000}, "minItems": 2, "maxItems": 2},
        "count": {"type": "number", "minimum": 0, "maximum": 3000},
        "seed": {"type": "number", "minimum": 0, "maximum": 2147483647},
        "plant_scale": {"type": "array", "items": {"type": "number", "minimum": 0.01, "maximum": 10}, "minItems": 2, "maxItems": 2},
        "spacing": {"type": "number", "minimum": 0.1, "maximum": 200},
        "range": {"type": "number", "minimum": 0, "maximum": 3000},
        "shadows": {"type": "boolean"},
        "align": {"type": "number", "minimum": 0, "maximum": 1},
        "sink": {"type": "number", "minimum": 0, "maximum": 10},
        "collider": {"type": "number", "minimum": 0, "maximum": 10},
        "collider_height": {"type": "number", "minimum": 0.1, "maximum": 30},
        "heightfield": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
        "region": {"type": "array", "items": {"type": "number", "minimum": -8000, "maximum": 8000}, "minItems": 4, "maxItems": 4},
        "y": {"type": "array", "items": {"type": "number", "minimum": -1000, "maximum": 1000}, "minItems": 2, "maxItems": 2},
        "slope": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
        "noise": {"type": "object", "properties": {"scale": {"type": "number", "minimum": 0.1, "maximum": 3000}, "threshold": {"type": "number", "minimum": 0, "maximum": 1}}, "required": []},
        "exclusions": {"type": "array", "items": {"type": "array", "items": {"type": "number", "minimum": -8000, "maximum": 8000}, "minItems": 4, "maxItems": 4}, "maxItems": 32}
      }
    },
    "water": {
      "label": "Water surface",
      "description": "A pond, round pool, flowing stream or ocean. Place it over a basin or stream bed.",
      "script": "res://scripts/pieces/water_piece.gd",
      "required": ["water_kind", "water_size"],
      "defaults": {"water_kind": "pool", "water_size": [6, 10], "mirror": false},
      "fields": {
        "water_kind": {"type": "string", "enum": ["pool", "round", "stream", "ocean"]},
        "water_size": {"type": "array", "items": {"type": "number", "minimum": 0.1, "maximum": 8000}, "minItems": 2, "maxItems": 2},
        "flow_speed": {"type": "number", "minimum": -10, "maximum": 10},
        "detail": {"type": "number", "minimum": 0, "maximum": 240},
        "mirror": {"type": "boolean"},
        "water_id": {"type": "string", "maxLength": 96},
        "water_look": {"type": "object", "properties": {"shallow_color": {"$ref": "#/$defs/color"}, "deep_color": {"$ref": "#/$defs/color"}, "foam_color": {"$ref": "#/$defs/color"}, "roughness_value": {"type": "number", "minimum": 0, "maximum": 1}, "reflection_strength": {"type": "number", "minimum": 0, "maximum": 1}, "ripple_strength": {"type": "number", "minimum": 0, "maximum": 1}, "clarity": {"type": "number", "minimum": 0.05, "maximum": 8}, "foam_amount": {"type": "number", "minimum": 0, "maximum": 2}, "refraction": {"type": "number", "minimum": 0, "maximum": 0.06}}, "required": []}
      }
    },
    "pool_basin": {
      "label": "Pool with basin",
      "description": "Place a complete rectangular pool with lining, a rim and water. For an excavated pool, parent it directly to a terrain piece and set basin_mode to excavated.",
      "script": "res://scripts/pieces/water_piece.gd",
      "required": ["water_kind", "water_size", "basin_mode"],
      "defaults": {"water_kind": "pool", "water_size": [4, 6], "basin_mode": "raised", "basin_depth": 1.45},
      "validate_record": true,
      "validate_parent": true,
      "parent_defaults": {"terrain": {"basin_mode": "excavated"}},
      "fields": {
        "water_kind": {"type": "string", "enum": ["pool"]},
        "water_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 1.5, "maximum": 50}},
        "basin_mode": {"type": "string", "enum": ["raised", "excavated"]},
        "basin_depth": {"type": "number", "minimum": 0.35, "maximum": 5},
        "basin_material": {"$ref": "#/$defs/piece_material"},
        "mirror": {"type": "boolean"}
      }
    },
    "spray": {
      "label": "Water spray",
      "description": "An aimable particle jet for fountains and waterfalls.",
      "script": "res://scripts/pieces/spray_piece.gd",
      "required": [],
      "defaults": {"speed": 2.28, "lifetime": 0.42, "amount": 220},
      "fields": {
        "spray_direction": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}, "minItems": 3, "maxItems": 3},
        "speed": {"type": "number", "minimum": 0, "maximum": 30},
        "lifetime": {"type": "number", "minimum": 0.1, "maximum": 5},
        "amount": {"type": "number", "minimum": 1, "maximum": 1200},
        "spread": {"type": "number", "minimum": 0, "maximum": 90},
        "landing": {"$ref": "#/$defs/position"}
      }
    },
    "prop": {
      "label": "Physics prop",
      "description": "A cone, pressure plate, sliding door or model with a physics body.",
      "script": "res://scripts/pieces/prop_piece.gd",
      "validate_record": true,
      "required": ["prop_kind"],
      "defaults": {"prop_kind": "traffic_cone", "color": "f27825", "prop_size": 1.0, "locked": false},
      "storage": {
        "behavior": {"$ref":"#/$defs/behavior"}
      },
      "fields": {
        "prop_kind": {"type": "string", "enum": ["traffic_cone", "pressure_plate", "sliding_door", "library_model", "imported_model"]},
        "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"},
        "color": {"$ref": "#/$defs/color"},
        "prop_size": {"$ref": "#/$defs/scale"},
        "locked": {"type": "boolean"},
        "door_open": {"type": "number", "minimum": 0, "maximum": 1},
        "stretch": {"$ref": "#/$defs/stretch"},
        "animation": {"anyOf": [{"type":"null"}, {"$ref":"#/$defs/clip"}]}
      }
    },
    "simulation_water": {
      "label": "Baked water",
      "description": "Load a baked pool or coastal domain, including its simulation and optional wet-sand landscape.",
      "script": "res://scripts/pieces/simulation_water_piece.gd",
      "validate_record": true,
      "fixed_transform": true,
      "required": ["simulation", "domain", "bake", "level"],
      "defaults": {"simulation": "pool", "domain": [-3, -5, 6, 10], "level": 0},
      "fields": {
        "simulation": {"type": "string", "enum": ["pool", "coast"]},
        "domain": {"type": "array", "items": {"type": "number", "minimum": -8000, "maximum": 8000}, "minItems": 4, "maxItems": 4},
        "level": {"type": "number", "minimum": -1000, "maximum": 1000},
        "bake": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
        "water_id": {"type": "string", "maxLength": 96},
        "landscape": {"type": "object", "properties": {"asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "model_finish": {"type": "object", "properties": {"style": {"type": "string", "enum": ["pbr", "flat", "fresco", "foliage", "foliage_core", "coastal_terrain", "wet_sand"]}, "texture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "textures": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"}, "minItems": 3, "maxItems": 4}, "tint": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 4}, "minItems": 3, "maxItems": 3}, "fallback": {"$ref": "#/$defs/color"}, "tile": {"type": "number", "minimum": 0.05, "maximum": 100}, "roughness": {"type": "number", "minimum": 0, "maximum": 1}, "metallic": {"type": "number", "minimum": 0, "maximum": 1}, "frieze": {"type": "boolean"}, "period": {"type": "number", "minimum": 0.1, "maximum": 100}, "offset": {"type": "number", "minimum": -1000, "maximum": 1000}, "main_view_only": {"type": "boolean"}, "cast_shadow": {"type": "boolean"}, "hidden": {"type": "boolean"}, "sea_level": {"type": "number", "minimum": -1000, "maximum": 1000}, "beach_top": {"type": "number", "minimum": -1000, "maximum": 1000}}, "required": []}}, "required": ["asset_id"]},
        "ocean_layers": {"type": "array", "maxItems": 3, "items": {"type": "object", "properties": {"size": {"type": "array", "items": {"type": "number", "minimum": 1, "maximum": 8000}, "minItems": 2, "maxItems": 2}, "center": {"type": "array", "items": {"type": "number", "minimum": -8000, "maximum": 8000}, "minItems": 2, "maxItems": 2}, "detail": {"type": "number", "minimum": 0, "maximum": 240}, "horizon": {"type": "boolean"}}, "required": ["size", "center", "detail"]}}
      }
    },
    "buoyant": {
      "label": "Buoyant model",
      "description": "A Poly Haven model that floats and drifts with water.",
      "script": "res://scripts/pieces/buoyant_piece.gd",
      "required": ["asset_id"],
      "defaults": {"asset_id": "wine_barrel_01", "model_height": 0.9, "mass": 60},
      "fields": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
        "model_height": {"type": "number", "minimum": 0.01, "maximum": 30},
        "mass": {"type": "number", "minimum": 0.1, "maximum": 500}
      }
    },
    "model_batch": {
      "label": "Model batch",
      "description": "Batch multiple copies of a library model with explicit transforms.",
      "script": "res://scripts/pieces/model_batch_piece.gd",
      "required": ["asset_id", "model_instances"],
      "defaults": {"range": 90, "shadows": false},
      "fields": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
        "range": {"type": "number", "minimum": 0, "maximum": 3000},
        "shadows": {"type": "boolean"},
        "model_instances": {"type": "array", "maxItems": 512, "items": {"type": "object", "properties": {"position": {"$ref": "#/$defs/position"}, "rotation": {"type": "array", "items": {"type": "number", "minimum": -360, "maximum": 360}, "minItems": 3, "maxItems": 3}, "size": {"type": "array", "items": {"type": "number", "minimum": 0.01, "maximum": 20}, "minItems": 3, "maxItems": 3}}, "required": ["position", "rotation", "size"]}}
      }
    },
    "building": {
      "label": "Building plan",
      "description": "An editable footprint with a floor, exterior walls, roof, steps and interior partitions. Front faces local -Z.",
      "script": "res://scripts/pieces/building_piece.gd",
      "placement_yaw": 180,
      "placement_lift": 0.04,
      "interactions": true,
      "required": ["footprint", "wall_height"],
      "defaults": {"footprint": [6, 5], "wall_height": 2.7, "roof": "gable", "floor": true, "walls": true, "openings": {"front": {"kind": "door"}, "right": {"kind": "window", "motion": "slide"}}},
      "validate_record": true,
      "fields": {
        "footprint": {"type": "array", "description": "Width and depth in metres", "items": {"type": "number", "minimum": 2, "maximum": 64}, "minItems": 2, "maxItems": 2},
        "wall_height": {"type": "number", "minimum": 1, "maximum": 10},
        "wall_thickness": {"type": "number", "minimum": 0.08, "maximum": 0.7},
        "floor": {"type": "boolean"},
        "walls": {"type": "boolean"},
        "roof": {"type": "string", "enum": ["none", "flat", "gable"]},
        "roof_rise": {"type": "number", "minimum": 0.15, "maximum": 8},
        "openings": {"type": "object", "properties": {"front": {"$ref": "#/$defs/building_opening"}, "right": {"$ref": "#/$defs/building_opening"}, "back": {"$ref": "#/$defs/building_opening"}, "left": {"$ref": "#/$defs/building_opening"}}, "required": []},
        "wall_openings": {
          "type": "object", "description": "Opening lists for exterior walls. A list overrides the legacy single opening on that side.",
          "properties": {"front": {"$ref": "#/$defs/wall_opening_list"}, "right": {"$ref": "#/$defs/wall_opening_list"}, "back": {"$ref": "#/$defs/wall_opening_list"}, "left": {"$ref": "#/$defs/wall_opening_list"}},
          "required": []
        },
        "partitions": {"type": "array", "maxItems": 32, "description": "Interior walls from start to end [x,z] in local metres. Opening offsets are measured from each wall's midpoint.", "items": {"$ref": "#/$defs/partition"}},
        "steps": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "offset": {"type": "number", "minimum": -30, "maximum": 30}, "width": {"type": "number", "minimum": 0.5, "maximum": 20}, "rise": {"type": "number", "minimum": 0.1, "maximum": 5}, "run": {"type": "number", "minimum": 0.3, "maximum": 25}, "count": {"type": "number", "minimum": 1, "maximum": 32}}, "required": []},
        "material": {"$ref": "#/$defs/piece_material"},
        "floor_material": {"$ref": "#/$defs/piece_material"},
        "roof_material": {"$ref": "#/$defs/piece_material"}
      }
    },
    "house": {
      "label": "House",
      "description": "A complete single-storey home: foundation, rooms with doors and windows suited to each room, floors, ceilings and lights, a roof, entrance steps, a patio deck and furniture. Give bedrooms, bathrooms, layout and style and Euclid plans the rooms, or list exact rooms. The entrance faces local -Z.",
      "script": "res://scripts/pieces/house_piece.gd",
      "placement_yaw": 180,
      "placement_lift": 0.02,
      "interactions": true,
      "validate_record": true,
      "required": [],
      "defaults": {"style": "modern", "bedrooms": 2, "bathrooms": 1, "layout": "open"},
      "fields": {
        "style": {"type": "string", "description": "Finishes, roof and window proportions", "enum": ["modern", "desert", "farmhouse"]},
        "bedrooms": {"type": "number", "description": "Bedrooms when rooms is empty", "minimum": 0, "maximum": 5},
        "bathrooms": {"type": "number", "description": "Bathrooms when rooms is empty", "minimum": 1, "maximum": 3},
        "layout": {"type": "string", "description": "open joins living, kitchen, dining and hall without walls", "enum": ["open", "closed"]},
        "floor_area": {"type": "number", "description": "Approximate floor area in square metres when rooms is empty", "minimum": 0, "maximum": 400},
        "rooms": {
          "type": "array",
          "description": "Exact rooms instead of a generated plan. rect is [x0, z0, x1, z1] in local metres along wall centrelines; -Z is the front. Rooms must not overlap and must touch.",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["kind", "rect"],
            "properties": {
              "kind": {"type": "string", "enum": ["living", "kitchen", "dining", "bedroom", "bathroom", "hall", "office", "laundry", "closet"]},
              "name": {"type": "string", "maxLength": 40},
              "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -32, "maximum": 32}}
            }
          }
        },
        "ceiling_height": {"type": "number", "minimum": 2.3, "maximum": 4.5},
        "foundation_height": {"type": "number", "description": "Floor height above the ground", "minimum": 0, "maximum": 1.5},
        "roof": {"type": "string", "description": "style uses the style's roof", "enum": ["style", "flat", "parapet", "gable", "none"]},
        "pool": {"type": "boolean", "description": "A stone terrace with an in-ground pool outside the living room's patio door. Parent the house to a terrain to dig the basin."},
        "pool_size": {"type": "array", "description": "Water length along the house and width out from it, in metres", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 2, "maximum": 20}},
        "pool_depth": {"type": "number", "minimum": 0.6, "maximum": 3},
        "furnish": {"type": "boolean"},
        "lights": {"type": "boolean"},
        "walls": {
          "type": "array",
          "description": "Wall finish rules over the style's own (later rules win). finish names an entry in data/pieces/wall_finishes.json (paint_white, paint_sage, plaster_lime, brick_whitewashed, brick_red, wood_shiplap, wood_panels, tile_white, tile_mosaic, tile_terrazzo, tile_marble, concrete_board, stone_stacked, ...) or give a material instead. room is all, a room kind or a room name; side is all, feature (the wall the bed or the sofa and TV are arranged against), or front, back, left or right (-Z, +Z, -X, +X). height covers only the lower part of the wall (wainscot, splash tiles).",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [],
            "properties": {
              "room": {"type": "string", "maxLength": 40},
              "side": {"type": "string", "enum": ["all", "feature", "front", "back", "left", "right"]},
              "finish": {"type": "string", "maxLength": 40},
              "material": {"$ref": "#/$defs/piece_material"},
              "height": {"type": "number", "minimum": 0.05, "maximum": 4.5}
            }
          }
        },
        "backsplash": {"anyOf": [{"type": "string", "maxLength": 40}, {"$ref": "#/$defs/piece_material"}], "description": "Kitchen splashback: a wall finish name or a material"},
        "furnishings": {
          "type": "object",
          "description": "The library model for a furniture slot, overriding the style's picks (see data/pieces/house_furnishings.json for slots and suggested models). none keeps the simple stand-in.",
          "required": [],
          "properties": {"sofa": {"type": "string", "maxLength": 80}, "armchair": {"type": "string", "maxLength": 80}, "coffee_table": {"type": "string", "maxLength": 80}, "side_table": {"type": "string", "maxLength": 80}, "media_unit": {"type": "string", "maxLength": 80}, "dining_chair": {"type": "string", "maxLength": 80}, "bar_stool": {"type": "string", "maxLength": 80}, "nightstand": {"type": "string", "maxLength": 80}, "storage": {"type": "string", "maxLength": 80}, "bookshelf": {"type": "string", "maxLength": 80}, "plant": {"type": "string", "maxLength": 80}, "pendant": {"type": "string", "maxLength": 80}, "art": {"type": "string", "maxLength": 80}, "bed": {"type": "string", "maxLength": 80}, "toilet": {"type": "string", "maxLength": 80}, "tv": {"type": "string", "maxLength": 80}, "floor_lamp": {"type": "string", "maxLength": 80}, "bed_guest": {"type": "string", "maxLength": 80}, "fridge": {"type": "string", "maxLength": 80}, "range": {"type": "string", "maxLength": 80}, "cooktop": {"type": "string", "maxLength": 80}, "bathtub": {"type": "string", "maxLength": 80}, "vanity": {"type": "string", "maxLength": 80}}
        },
        "materials": {
          "type": "object",
          "description": "Material overrides merged over the style. Each may name a wall finish (data/pieces/wall_finishes.json) instead, for example exterior: cladding_panels",
          "required": [],
          "properties": {
            "exterior": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "interior": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "trim": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "roof": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "fascia": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "plinth": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "door": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "entry_door": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]},
            "accent": {"anyOf": [{"$ref": "#/$defs/piece_material"}, {"type": "string", "maxLength": 40}]}
          }
        }
      }
    },
    "stairs": {
      "label": "Stairs",
      "description": "Walkable stairs connecting two heights. The top meets local Z = 0.",
      "script": "res://scripts/pieces/stairs_piece.gd",
      "required": ["stair_plan"],
      "defaults": {"stair_plan": {"rise": 0.6, "run": 1.25, "width": 1.35, "count": 4}},
      "fields": {
        "stair_plan": {"$ref": "#/$defs/stair_plan"},
        "material": {"$ref": "#/$defs/piece_material"}
      }
    },
    "video_screen": {
      "label": "Video screen",
      "description": "A video or playlist from a YouTube link, or an imported local file. The screen faces local +Z.",
      "script": "res://scripts/pieces/video_screen_piece.gd",
      "validate_record": true,
      "placement_yaw": 0,
      "placement_lift": 1.5,
      "interactions": true,
      "required": ["screen_size"],
      "defaults": {"screen_size": [2.4, 1.35], "autoplay": true, "loop": true, "volume": 0.8},
      "fields": {
        "screen_size": {"type": "array", "description": "Width and height in metres", "items": {"type":"number","minimum":0.2,"maximum":30}, "minItems":2,"maxItems":2},
        "youtube_url": {"type": "string", "description": "Paste a YouTube video or playlist link. Clear it to use a local file.", "maxLength": 1024},
        "video_id": {"type": "string", "catalog": "local_video", "pattern": "^([a-f0-9]{32})?$"},
        "autoplay": {"type": "boolean"},
        "loop": {"type": "boolean"},
        "volume": {"type": "number","minimum":0,"maximum":1}
      }
    },
    "terrain": {
      "label": "Terrain",
      "description": "A walkable surface for sculpting and painting with the terrain brush.",
      "script": "res://scripts/pieces/terrain_piece.gd",
      "required": ["terrain_size"],
      "defaults": { "terrain_size": [128, 128] },
      "fields": {
        "terrain_size": { "type": "array", "description": "Width and depth in metres", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 16, "maximum": 1200 } },
        "cast_shadow": { "type": "boolean" }
      },
      "storage": {
        "terrain_surface": { "type": "string", "maxLength": 360000, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "terrain_paint_data": { "type": "string", "maxLength": 450000, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "terrain_materials": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" } }
      }
    }
  }
}
