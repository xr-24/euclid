{
  "version": 1,
  "about": "Registered piece types. Environment documents, agents and the build menu use these; see docs/environment-authoring.md. Field rules use the same format as data/commands/schema.json and may $ref its $defs.",
  "common": {
    "id": { "type": "string", "description": "Unique within the environment", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$" },
    "type": { "type": "string", "maxLength": 32 },
    "name": { "type": "string", "maxLength": 64 },
    "position": { "$ref": "#/$defs/position" },
    "rotation": { "type": "array", "description": "Degrees about X, Y and Z", "items": { "type": "number", "minimum": -360, "maximum": 360 }, "minItems": 3, "maxItems": 3 },
    "scale": { "type": "array", "description": "Scale along X, Y and Z", "items": { "type": "number", "minimum": 0.01, "maximum": 100 }, "minItems": 3, "maxItems": 3 },
    "hidden": { "type": "boolean" }
  },
  "types": {
    "group": {
      "label": "Group",
      "description": "Holds child pieces so they move, turn and hide together.",
      "script": "res://scripts/pieces/group_piece.gd",
      "required": [],
      "fields": {}
    },
    "shape": {
      "label": "Shape",
      "description": "A solid box, sphere, cylinder, capsule or flat plane with a material. Round shapes use size X as the diameter and size Y as the height.",
      "script": "res://scripts/pieces/shape_piece.gd",
      "required": ["shape", "size"],
      "defaults": { "shape": "box", "size": [1, 1, 1] },
      "fields": {
        "shape": { "type": "string", "enum": ["box", "sphere", "cylinder", "capsule", "plane"] },
        "size": { "type": "array", "description": "Metres along X, Y and Z", "items": { "type": "number", "minimum": 0.01, "maximum": 2000 }, "minItems": 3, "maxItems": 3 },
        "material": {"$ref": "#/$defs/piece_material"},
        "render": {"type": "boolean", "description": "Draw the shape. A collision-only shape can stay solid while invisible."},
        "collision_size": {"type": "array", "description": "Optional size of a box collider, independent of the visible shape.", "items": {"type": "number", "minimum": 0.01, "maximum": 2000}, "minItems": 3, "maxItems": 3},
        "collision": { "type": "boolean" },
        "cast_shadow": { "type": "boolean" }
      }
    },
    "light": {
      "label": "Light",
      "description": "A point (omni) or spot light. Spots shine along the piece's -Z.",
      "script": "res://scripts/pieces/light_piece.gd",
      "required": ["kind"],
      "defaults": { "kind": "omni" },
      "fields": {
        "kind": { "type": "string", "enum": ["omni", "spot"] },
        "color": { "$ref": "#/$defs/color" },
        "energy": { "type": "number", "minimum": 0, "maximum": 100 },
        "range": { "type": "number", "minimum": 0.1, "maximum": 500 },
        "angle": { "type": "number", "minimum": 1, "maximum": 89 },
        "shadows": { "type": "boolean" }
      }
    },
    "model": {
      "label": "Model",
      "description": "A model from the installed library or an imported asset.",
      "script": "res://scripts/pieces/model_piece.gd",
      "required": ["source", "asset_id"],
      "defaults": { "source": "library" },
      "fields": {
        "source": { "type": "string", "enum": ["library", "runtime"] },
        "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$" },
        "collision": { "type": "boolean" }
      }
    },
    "box_batch": {
      "label": "Box batch",
      "description": "Draw many decorative boxes as one batch. Each box has a position, rotation and size relative to the piece.",
      "script": "res://scripts/pieces/box_batch_piece.gd",
      "required": [
        "instances"
      ],
      "defaults": {
        "instances": [
          {
            "position": [
              0,
              0,
              0
            ],
            "rotation": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ]
          }
        ]
      },
      "fields": {
        "instances": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "required": ["position", "rotation", "size"], "properties": {"position": {"$ref": "#/$defs/position"}, "rotation": {"type": "array", "description": "Degrees about X, Y and Z", "items": {"type": "number", "minimum": -360, "maximum": 360}, "minItems": 3, "maxItems": 3}, "size": {"type": "array", "description": "Metres along X, Y and Z", "items": {"type": "number", "minimum": 0.01, "maximum": 2000}, "minItems": 3, "maxItems": 3}}}},
        "material": {"$ref": "#/$defs/piece_material"},
        "height_scale": {"type": "number", "description": "Scale the batch and its offsets along its local Y axis", "minimum": 0.1, "maximum": 8},
        "cast_shadow": {"type": "boolean"}
      }
    },
    "terrain": {
      "label": "Terrain",
      "description": "A walkable surface for sculpting and painting with the terrain brush.",
      "script": "res://scripts/pieces/terrain_piece.gd",
      "required": ["terrain_size"],
      "defaults": { "terrain_size": [128, 128] },
      "fields": {
        "terrain_size": { "type": "array", "description": "Width and depth in metres", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 16, "maximum": 1200 } },
        "cast_shadow": { "type": "boolean" }
      },
      "storage": {
        "terrain_surface": { "type": "string", "maxLength": 360000, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "terrain_paint_data": { "type": "string", "maxLength": 450000, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "terrain_materials": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" } }
      }
    }
  }
}
